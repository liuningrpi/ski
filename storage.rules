rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /tracks/{uid}/{sessionID}/{fileName} {
      allow read, write: if isOwner(uid)
        && fileName.matches('.*\\.lzfse')
        && (request.resource == null || request.resource.size < 64 * 1024 * 1024);
    }

    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(uid)
        && (request.resource == null || request.resource.size < 5 * 1024 * 1024);
    }

    match /feedback/{uid}/{fileName} {
      allow read, write: if isOwner(uid)
        && (request.resource == null || request.resource.size < 8 * 1024 * 1024);
    }
  }
}
